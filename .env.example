NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only
ROOT_DOMAIN=sitomax.com
NEXT_PUBLIC_ROOT_DOMAIN=sitomax.com
NEXT_PUBLIC_APP_URL=https://app.sitomax.com
MARKETING_SITE_SUBDOMAIN=sitomax
NEXT_PUBLIC_AGENCY_NAME=SitoMax
VERCEL_API_TOKEN=                 # server only
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=                   # optional
CRON_SECRET=                     # server only; random secret for scheduled domain and lead jobs
LEAD_WORKER_SECRET=              # server only; separate random secret (openssl rand -hex 32); register only its SHA-256 hash in Supabase
POSTMARK_SERVER_TOKEN=           # server only
POSTMARK_FROM_EMAIL=             # verified sender, e.g. SitoMax <support@sitomax.com>
POSTMARK_MESSAGE_STREAM=outbound # transactional stream
POSTMARK_LEADS_STREAM=           # dedicated transactional outbound stream ID for lead replies and forwards
LEADS_FROM_DOMAIN=               # verified sending domain for leads@...
INBOUND_REPLY_DOMAIN=            # Postmark inbound forwarding domain
LEAD_REPLY_TOKEN_SECRET=         # server only; random secret (openssl rand -hex 32); keep stable for existing threads
POSTMARK_INBOUND_WEBHOOK_USER=    # server only; Basic Auth username
POSTMARK_INBOUND_WEBHOOK_PASSWORD= # server only; Basic Auth password
SUPABASE_SEND_EMAIL_HOOK_SECRET= # server only; signed Auth email hook secret

ANTHROPIC_API_KEY=               # server only; AI requests fail closed if unset
ANTHROPIC_MODEL=claude-sonnet-5-5 # server only; select a model with configured pricing
PIXABAY_API_KEY=                 # server only; optional, otherwise use image placeholders
ANALYTICS_HASH_SALT=             # server only; random secret of at least 32 characters
PAGESPEED_API_KEY=               # server only; optional PageSpeed Insights key
GOOGLE_PLACES_API_KEY=           # server only; enables Google Places checks
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Cloudflare Turnstile site key
TURNSTILE_SECRET_KEY=            # server only; Cloudflare Turnstile secret
GRADER_WORKER_SECRET=            # server only; random secret; register its SHA-256 hash in grader_config
GRADER_LEADS_ACCOUNT_ID=         # Phase B: account receiving grader leads
GRADER_LEADS_SITE_ID=            # Phase B: site receiving grader leads
GRADER_NOTIFICATION_EMAIL=       # server only: address receiving grader lead notifications
